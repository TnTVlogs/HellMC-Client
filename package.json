{
  "name": "hellmcclient",
  "version": "2.0.0-alpha.3",
  "productName": "HellMC Client",
  "description": "HellMC Client (by TnTVlogs)",
  "author": "TnTVlogs (https://github.com/TnTVlogs/)",
  "license": "MIT",
  "homepage": "https://github.com/TnTVlogs/HellMC-Client",
  "bugs": {
    "url": "https://github.com/TnTVlogs/HellMC-Client/issues"
  },
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "npm run build:renderer && electron .",
    "dev:renderer": "vite --config renderer/vite.config.mts",
    "dev:electron": "wait-on tcp:5173 && cross-env RENDERER_DEV_SERVER=1 electron .",
    "dev": "concurrently -k -n vite,electron \"npm:dev:renderer\" \"npm:dev:electron\"",
    "build:renderer": "vite build --config renderer/vite.config.mts",
    "dist": "npm run build:renderer && electron-builder build",
    "dist:win": "npm run dist -- -w",
    "dist:mac": "npm run dist -- -m",
    "dist:linux": "npm run dist -- -l",
    "lint": "biome lint .",
    "test:e2e": "npm run build:renderer && playwright test",
    "test": "vitest run --config renderer/vite.config.mts && node test/modgroups.test.js && node test/serversdat.test.js && node test/configmanager.test.js && node test/applog.test.js && node test/security.test.js && node test/preload-constants.test.js && node test/offline-uuid.test.js && node test/datasharing.test.js && node test/telemetry.test.js && node test/skins.test.js && node test/wardrobe.test.js && node test/runtime.test.js && node test/catalogsync.test.js && node test/pngutil.test.js && node test/receiver-spawner.test.js && node test/downloadeta.test.js"
  },
  "engines": {
    "node": "22.x.x"
  },
  "dependencies": {
    "@preact/signals": "^2.11.2",
    "adm-zip": "^0.6.1",
    "discord-rpc-patch": "^4.0.1",
    "dompurify": "^3.4.16",
    "electron-updater": "^6.7.3",
    "fs-extra": "^11.3.3",
    "hellmc-core": "github:TnTVlogs/HellMC-Core#v3.0.0-hellmc.2",
    "hellmc-distribution-types": "github:TnTVlogs/HellMC-Distribution-Types#v1.0.0",
    "lucide-preact": "^1.51.0",
    "marked": "^18.0.14",
    "mcstatus-util": "^5.4.6",
    "preact": "^10.24.3",
    "rss-parser": "^3.13.0",
    "semver": "^7.7.3",
    "skinview3d": "^3.4.2",
    "three": "^0.156.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/preact": "^3.2.4",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.4.0",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3",
    "wait-on": "^9.5.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TnTVlogs/HellMC-Client.git"
  },
  "overrides": {
    "hellmc-distribution-types": "$hellmc-distribution-types"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "electron-winstaller@5.4.0": true,
    "electron@44.4.5": true
  }
}
