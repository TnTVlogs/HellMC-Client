{
  "name": "hellmcclient",
  "version": "1.2.2",
  "productName": "HellMC Client",
  "description": "HellMC Client (by TnTVlogs)",
  "author": "TnTVlogs (https://github.com/TnTVlogs/)",
  "license": "MIT",
  "homepage": "https://github.com/TnTVlogs/HellMC-Client",
  "bugs": {
    "url": "https://github.com/TnTVlogs/HellMC-Client/issues"
  },
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "dev:renderer": "vite --config renderer/vite.config.ts",
    "dev:electron": "wait-on tcp:5173 && cross-env RENDERER_DEV_SERVER=1 OPEN_RENDERER_TEST=1 electron .",
    "dev": "concurrently -k -n vite,electron \"npm:dev:renderer\" \"npm:dev:electron\"",
    "build:renderer": "vite build --config renderer/vite.config.ts",
    "dist": "electron-builder build",
    "dist:win": "npm run dist -- -w",
    "dist:mac": "npm run dist -- -m",
    "dist:linux": "npm run dist -- -l",
    "lint": "eslint --config .eslintrc.json ."
  },
  "engines": {
    "node": "22.x.x"
  },
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "@preact/signals": "^1.3.2",
    "adm-zip": "^0.5.16",
    "discord-rpc-patch": "^4.0.1",
    "ejs": "^3.1.10",
    "ejs-electron": "^3.0.0",
    "electron-updater": "^6.7.3",
    "fs-extra": "^11.3.3",
    "github-syntax-dark": "^0.5.0",
    "got": "^11.8.5",
    "hellmc-core": "file:../HellMC-Core",
    "hellmc-distribution-types": "file:../HellMC-Distribution-Types",
    "jquery": "^3.7.1",
    "lodash.merge": "^4.6.2",
    "preact": "^10.24.3",
    "semver": "^7.7.3",
    "toml": "^3.0.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.3",
    "@typescript-eslint/parser": "^8.19.0",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^39.2.7",
    "electron-builder": "^26.4.0",
    "eslint": "^8.57.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TnTVlogs/HellMC-Client.git"
  }
}
